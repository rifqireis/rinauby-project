// =============================================================================
// WAYBAR CONFIGURATION: RINAUBY (ACADEMIC HUMANIST)
// Filosofi: Digital Humanism & School of Athens
// Estetika: Top Docked (margin-top: 0), Garis Emas Bawah, Dynamic Wallpaper Title
// =============================================================================

{
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin-top": 0,
    "margin-left": -1,
    "margin-right": -1,
    "spacing": 0,
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,
    "reload_style_on_change": true,

    "modules-left": [
        "custom/logo",
        "hyprland/workspaces",
        "custom/separator-left",
        "custom/window-title"
    ],

    "modules-center": [
        "custom/quote"
    ],

    "modules-right": [
        "pulseaudio",
        "battery",
        "custom/separator-right",
        "clock"
    ],

    // -------------------------------------------------------------------------
    // 1. SISI KIRI (Logo, Workspaces Romawi, Window Title / Wallpaper Title)
    // -------------------------------------------------------------------------
    "custom/logo": {
        "format": "",
        "tooltip": true,
        "tooltip-format": "Menu (Click to Launch)",
        "on-click": "sh -c 'if command -v rinauby-launcher >/dev/null 2>&1; then exec rinauby-launcher; else exec rofi -show drun -theme /home/rifqi/Workspace/Belajar/SO/Tubes-2604/Rancangan/assets/dotfiles/rofi/renaissance_launcher.rasi; fi'"
    },

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "on-click": "activate",
        "format": "{icon}",
        "format-icons": {
            "1": "I",
            "2": "II",
            "3": "III",
            "4": "IV",
            "5": "V",
            "6": "VI",
            "7": "VII",
            "8": "VIII",
            "9": "IX",
            "10": "X",
            "default": "{name}"
        },
        "persistent-workspaces": {
            "*": 5
        }
    },

    "custom/separator-left": {
        "format": "│",
        "tooltip": false
    },

    "custom/window-title": {
        "format": "{}",
        "return-type": "json",
        "exec": "sh -c 'if command -v rinauby-window-title >/dev/null 2>&1; then exec rinauby-window-title; elif [ -f \"$HOME/.config/waybar/window_title.py\" ]; then exec python3 \"$HOME/.config/waybar/window_title.py\"; else exec /home/rifqi/Workspace/Belajar/SO/Tubes-2604/Rancangan/assets/dotfiles/waybar/window_title.py; fi'",
        "tooltip": true
    },

    // -------------------------------------------------------------------------
    // 2. SISI TENGAH (Semboyan Klasik Renaissance Humanism)
    // -------------------------------------------------------------------------
    "custom/quote": {
        "format": "{}",
        "exec": "sh -c 'if command -v rinauby-quote >/dev/null 2>&1; then exec rinauby-quote; elif [ -f \"$HOME/.config/waybar/quote_rotator.sh\" ]; then exec bash \"$HOME/.config/waybar/quote_rotator.sh\"; else exec /home/rifqi/Workspace/Belajar/SO/Tubes-2604/Rancangan/assets/dotfiles/waybar/quote_rotator.sh; fi'",
        "interval": 180,
        "signal": 8,
        "tooltip": true,
        "tooltip-format": "Philosophy & Quotes\n(Click to rotate)",
        "on-click": "sh -c 'if command -v rinauby-quote >/dev/null 2>&1; then rinauby-quote --next; elif [ -f \"$HOME/.config/waybar/quote_rotator.sh\" ]; then bash \"$HOME/.config/waybar/quote_rotator.sh\" --next; else /home/rifqi/Workspace/Belajar/SO/Tubes-2604/Rancangan/assets/dotfiles/waybar/quote_rotator.sh --next; fi; pkill -RTMIN+8 waybar'"
    },

    // -------------------------------------------------------------------------
    // 3. SISI KANAN (Esensial: Audio, Baterai, Waktu)
    // -------------------------------------------------------------------------
    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "󰝟  Muted",
        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "󰋋",
            "headset": "󰋋",
            "phone": "󰏲",
            "portable": "󰏲",
            "car": "󰄋",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "scroll-step": 5,
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "tooltip-format": "Volume: {volume}%\nSink: {desc}"
    },

    "battery": {
        "interval": 10,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}  {capacity}%",
        "format-charging": "󰂄  {capacity}%",
        "format-plugged": "󰂄  {capacity}%",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
        "tooltip-format": "{timeTo}\nDaya: {power} W"
    },

    "custom/separator-right": {
        "format": "│",
        "tooltip": false
    },

    "clock": {
        "interval": 1,
        "format": "{0:%a, %d %b  %H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "on-click": "rinauby-syspanel",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#db9c5e'><b>{}</b></span>",
                "days": "<span color='#d3c6aa'>{}</span>",
                "weeks": "<span color='#9d9a85'>W{}</span>",
                "weekdays": "<span color='#e5c07b'><b>{}</b></span>",
                "today": "<span color='#1c2124' bgcolor='#e5c07b'><b>{}</b></span>"
            }
        }
    }
}
