/**
 * =============================================================================
 * RENAISSANCE OS : ROFI APPLICATION LAUNCHER
 * Filosofi: Digital Humanism & The Renaissance of Open Source
 * Desain: Bersih, Humanis Modern (Font Inter), Kedalaman Tonal & Ambient Shadow
 * Aturan: Tanpa outline oranye (hanya pada Waybar), hairline kaca ultra-subtle
 * =============================================================================
 */

configuration {
    modi: "drun,run";
    show-icons: true;
    display-drun: " ";
    drun-display-format: "{name}\n<span size='9500' color='#859289'>{generic}</span>";
    font: "Inter 12";
}

@import "theme_colors.rasi"

* {
    background-color: transparent;
    text-color: @fg-main;
    margin: 0px;
    padding: 0px;
    spacing: 0px;
}

window {
    width: 680px;
    background-color: @bg-base;
    border: 1px;
    border-color: @border-subtle;
    border-radius: 16px;
    padding: 24px;
    location: center;
    anchor: center;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 16px;
}

inputbar {
    background-color: @bg-input;
    border: 1px;
    border-color: @border-hairline;
    border-radius: 10px;
    padding: 12px 18px;
    children: [ prompt, entry ];
    spacing: 12px;
}

prompt {
    font: "Inter 13";
    text-color: @accent-gold;
    vertical-align: 0.5;
}

entry {
    placeholder: "Search knowledge, tools, apps...";
    placeholder-color: @fg-muted;
    text-color: @fg-bright;
    font: "Inter 12.5";
    vertical-align: 0.5;
    cursor: text;
}

listview {
    lines: 6;
    columns: 1;
    cycle: true;
    dynamic: true;
    fixed-height: false;
    scrollbar: false;
    spacing: 6px;
}

element {
    padding: 10px 16px;
    border-radius: 10px;
    spacing: 16px;
    border: 0px;
    children: [ element-icon, element-text ];
    cursor: pointer;
}

element normal.normal {
    background-color: transparent;
    text-color: @fg-main;
}

element alternate.normal {
    background-color: transparent;
    text-color: @fg-main;
}

element selected.normal {
    background-color: @bg-selected;
    text-color: @fg-bright;
    border: 0px;
    border-radius: 10px;
}

element-icon {
    size: 40px;
    vertical-align: 0.5;
    cursor: inherit;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
    font: "Inter 12";
    cursor: inherit;
}
