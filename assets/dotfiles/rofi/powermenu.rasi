* {
    font: "Inter Bold 9";
    bg-base: rgba(20, 24, 28, 0.96);
    bg-card: rgba(32, 38, 44, 0.80);
    bg-active: rgba(48, 57, 66, 0.95);
    border-subtle: rgba(255, 255, 255, 0.05);
    border-card: rgba(255, 255, 255, 0.04);
    border-selected: rgba(255, 255, 255, 0.12);
    fg-main: #d3c6aa;
    fg-bright: #fbf2db;
    fg-gold: #e5c07b;

    background-color: transparent;
    text-color: @fg-main;
    margin: 0px;
    padding: 0px;
}

window {
    width: 680px;
    background-color: @bg-base;
    border: 1px;
    border-color: @border-subtle;
    border-radius: 16px;
    padding: 26px 28px 28px 28px;
    location: center;
    anchor: center;
}

mainbox {
    children: [ textbox-title, listview ];
    spacing: 22px;
}

textbox-title {
    str: "RINAUBY — SESSION CONTROLS";
    font: "Cinzel Bold 12";
    text-color: @fg-gold;
    horizontal-align: 0.5;
    expand: false;
}

listview {
    layout: horizontal;
    lines: 5;
    spacing: 16px;
    fixed-height: true;
}

element {
    orientation: vertical;
    padding: 16px 12px 14px 12px;
    border-radius: 12px;
    background-color: @bg-card;
    border: 1px;
    border-color: @border-card;
    width: 110px;
    spacing: 10px;
    children: [ element-icon, element-text ];
    cursor: pointer;
}

element selected.normal {
    background-color: @bg-active;
    border-color: @border-selected;
}

element-icon {
    size: 40px;
    horizontal-align: 0.5;
    cursor: pointer;
}

element-text {
    horizontal-align: 0.5;
    text-color: @fg-main;
    cursor: pointer;
}

element selected.normal element-text {
    text-color: @fg-bright;
}
