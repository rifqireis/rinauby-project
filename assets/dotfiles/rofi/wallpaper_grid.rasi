/**
 * =============================================================================
 * SCHOOL OF ATHENS : ROFI WALLPAPER SELECTOR GRID
 * Visual Grid Layout: 2 Rows x 4 Columns
 * Desain: Bersih, Humanis Modern (Font Inter), Tanpa Outline Nanggung
 * =============================================================================
 */

* {
    font: "Inter 11";
    bg-base: rgba(28, 33, 37, 0.95);
    bg-card: rgba(42, 50, 56, 0.85);
    bg-active: rgba(219, 156, 94, 0.22);
    border-gold: #db9c5e;
    fg-main: #d3c6aa;
    fg-bright: #fbf2db;
    fg-muted: #859289;

    background-color: transparent;
    text-color: @fg-main;
    margin: 0px;
    padding: 0px;
}

window {
    width: 980px;
    background-color: @bg-base;
    border: 1.5px;
    border-color: @border-gold;
    border-radius: 16px;
    padding: 24px;
    location: center;
    anchor: center;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 18px;
}

inputbar {
    background-color: rgba(18, 22, 25, 0.75);
    border: 0px;
    border-radius: 10px;
    padding: 12px 18px;
    children: [ prompt, entry ];
    spacing: 12px;
}

prompt {
    font: "Inter 13";
    text-color: @border-gold;
    vertical-align: 0.5;
}

entry {
    placeholder: "Search / Choose Wallpaper";
    placeholder-color: @fg-muted;
    text-color: @fg-bright;
    font: "Inter 12";
    vertical-align: 0.5;
}

listview {
    layout: vertical;
    lines: 2;
    columns: 4;
    cycle: true;
    dynamic: false;
    spacing: 16px;
    flow: horizontal;
    fixed-columns: true;
}

element {
    orientation: vertical;
    padding: 6px 6px 30px 6px;
    border-radius: 12px;
    background-color: @bg-card;
    border: 0px;
    spacing: 0px;
    children: [ element-icon, element-text ];
}

element selected.normal {
    background-color: @bg-active;
    border: 2px;
    border-color: @border-gold;
}

element-icon {
    size: 195px;
    horizontal-align: 0.5;
    border-radius: 8px;
}

element-text {
    font: "Inter 11";
    horizontal-align: 0.5;
    text-color: #d3c6aa;
}

element selected.normal element-text {
    text-color: #fbf2db;
}
