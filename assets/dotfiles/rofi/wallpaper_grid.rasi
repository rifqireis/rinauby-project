/**
 * =============================================================================
 * RINAUBY : HORIZONTAL CAROUSEL WALLPAPER SELECTOR
 * Inspired by Community Coverflow & Modern Hyprland Wallpaper Carousels
 * Layout: Horizontal Panoramic Card Strip with Large Previews & Popin Animation
 * Desain: Bersih, Humanis Modern (Font Inter), Kedalaman Tonal & Ambient Shadow
 * Aturan: Tanpa outline oranye (hanya pada Waybar), hairline kaca ultra-subtle
 * =============================================================================
 */

configuration {
    modi: "dmenu";
    show-icons: true;
    drun-display-format: "{name}";
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}

* {
    font: "Inter 11";
    bg-base: rgba(19, 23, 27, 0.96);
    bg-card: rgba(30, 36, 42, 0.80);
    bg-card-hover: rgba(42, 50, 58, 0.92);
    bg-selected: rgba(48, 57, 66, 0.96);
    border-subtle: rgba(255, 255, 255, 0.05);
    border-card: rgba(255, 255, 255, 0.04);
    border-selected: rgba(255, 255, 255, 0.12);
    accent-gold: #db9c5e;
    accent-gold-bright: #e5c07b;
    fg-main: #d3c6aa;
    fg-bright: #fbf2db;
    fg-muted: #859289;

    background-color: transparent;
    text-color: @fg-main;
    margin: 0px;
    padding: 0px;
}

window {
    width: 94%;
    max-width: 1720px;
    height: 520px;
    background-color: @bg-base;
    border: 1px;
    border-color: @border-subtle;
    border-radius: 20px;
    padding: 24px 28px;
    location: center;
    anchor: center;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 18px;
}

inputbar {
    background-color: rgba(13, 16, 19, 0.85);
    border: 1px;
    border-color: @border-card;
    border-radius: 12px;
    padding: 10px 18px;
    children: [ prompt, entry ];
    spacing: 12px;
}

prompt {
    font: "Inter 13";
    text-color: @accent-gold;
    vertical-align: 0.5;
}

entry {
    placeholder: "Search or browse wallpapers with Left / Right arrows...";
    placeholder-color: @fg-muted;
    text-color: @fg-bright;
    font: "Inter 12";
    vertical-align: 0.5;
    horizontal-align: 0.0;
}

listview {
    layout: horizontal;
    lines: 8;
    columns: 1;
    spacing: 16px;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    fixed-height: true;
}

element {
    orientation: vertical;
    width: 190px;
    padding: 10px 10px 14px 10px;
    border-radius: 14px;
    background-color: @bg-card;
    border: 1px;
    border-color: @border-card;
    spacing: 10px;
    children: [ element-icon, element-text ];
    cursor: pointer;
}

element normal.normal {
    background-color: @bg-card;
    border-color: @border-card;
    text-color: @fg-main;
}

element alternate.normal {
    background-color: @bg-card;
    border-color: @border-card;
    text-color: @fg-main;
}

element selected.normal {
    background-color: @bg-selected;
    border: 1px;
    border-color: @border-selected;
    text-color: @fg-bright;
}

element-icon {
    size: 280px;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    border-radius: 10px;
    cursor: pointer;
}

element-text {
    font: "Inter 10.5";
    horizontal-align: 0.5;
    vertical-align: 0.5;
    text-color: inherit;
    cursor: pointer;
}
