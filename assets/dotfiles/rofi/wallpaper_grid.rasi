/**
 * =============================================================================
 * RINAUBY : FLOATING CAROUSEL WALLPAPER SELECTOR
 * Inspired by Community Coverflow & Modern Hyprland Wallpaper Pickers
 * Layout: 100% Transparent Canvas with Floating Cards & Top Pill Filter
 * Desain: Bersih, Humanis Modern (Font Inter), Kedalaman Tonal & Ambient Shadow
 * =============================================================================
 */

configuration {
    modi: "dmenu";
    show-icons: true;
    drun-display-format: "{name}";
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}

* {
    font: "Inter 11";
    bg-card: rgba(26, 32, 38, 0.82);
    bg-card-hover: rgba(38, 46, 54, 0.92);
    bg-selected: rgba(48, 58, 68, 0.96);
    border-card: rgba(255, 255, 255, 0.05);
    border-selected: rgba(255, 255, 255, 0.20);
    accent-gold: #db9c5e;
    accent-gold-bright: #e5c07b;
    fg-main: #d3c6aa;
    fg-bright: #fbf2db;
    fg-muted: #859289;

    background-color: transparent;
    text-color: @fg-main;
    margin: 0px;
    padding: 0px;
}

window {
    width: 100%;
    height: 540px;
    background-color: transparent;
    border: 0px;
    padding: 0px;
    location: center;
    anchor: center;
}

mainbox {
    background-color: transparent;
    children: [ inputbar, listview ];
    spacing: 26px;
    padding: 10px 50px;
}

inputbar {
    width: 520px;
    horizontal-align: 0.5;
    background-color: rgba(20, 24, 28, 0.88);
    border: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 9999px;
    padding: 8px 22px;
    children: [ prompt, entry ];
    spacing: 12px;
}

prompt {
    font: "Inter 12";
    text-color: @accent-gold;
    vertical-align: 0.5;
}

entry {
    placeholder: "Browse wallpapers with Left / Right arrows...";
    placeholder-color: @fg-muted;
    text-color: @fg-bright;
    font: "Inter 11.5";
    vertical-align: 0.5;
    horizontal-align: 0.0;
}

listview {
    layout: horizontal;
    lines: 8;
    columns: 1;
    spacing: 18px;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    fixed-height: true;
    background-color: transparent;
}

element {
    orientation: vertical;
    width: 195px;
    padding: 10px 10px 14px 10px;
    border-radius: 16px;
    background-color: @bg-card;
    border: 1px;
    border-color: @border-card;
    spacing: 10px;
    children: [ element-icon, element-text ];
    cursor: pointer;
}

element normal.normal {
    background-color: @bg-card;
    border-color: @border-card;
    text-color: @fg-main;
}

element alternate.normal {
    background-color: @bg-card;
    border-color: @border-card;
    text-color: @fg-main;
}

element selected.normal {
    background-color: @bg-selected;
    border: 1.5px;
    border-color: @border-selected;
    text-color: @fg-bright;
}

element-icon {
    size: 280px;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    border-radius: 12px;
    cursor: pointer;
}

element-text {
    font: "Inter 10.5";
    horizontal-align: 0.5;
    vertical-align: 0.5;
    text-color: inherit;
    cursor: pointer;
}
