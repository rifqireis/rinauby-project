/**
 * =============================================================================
 * RENAISSANCE OS : ROFI SCREENSHOT MENU THEME
 * Filosofi: Digital Humanism & The Renaissance of Open Source
 * Desain: Modal Tengah Klasik, Garis Emas Antik, Panel Frosted Glass
 * =============================================================================
 */

configuration {
    show-icons: false;
    font: "JetBrainsMono Nerd Font 12";
}

* {
    bg-base: rgba(28, 33, 37, 0.92);
    bg-input: rgba(20, 24, 27, 0.70);
    bg-selected: rgba(45, 53, 59, 0.90);
    border-gold: #db9c5e;
    border-subtle: rgba(219, 156, 94, 0.60);
    fg-main: #d3c6aa;
    fg-bright: #fbf2db;
    fg-muted: #859289;

    background-color: transparent;
    text-color: @fg-main;
    margin: 0px;
    padding: 0px;
    spacing: 0px;
}

window {
    width: 440px;
    background-color: @bg-base;
    border: 1.5px;
    border-color: @border-gold;
    border-radius: 12px;
    padding: 20px;
    location: center;
    anchor: center;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 14px;
}

inputbar {
    background-color: @bg-input;
    border: 1px;
    border-color: @border-subtle;
    border-radius: 8px;
    padding: 8px 14px;
    children: [ prompt, entry ];
    spacing: 10px;
}

prompt {
    text-color: @border-gold;
    font: "JetBrainsMono Nerd Font Bold 12";
}

entry {
    placeholder: "Pilih aksi tangkapan layar...";
    placeholder-color: @fg-muted;
    text-color: @fg-bright;
    font: "JetBrainsMono Nerd Font 12";
    cursor: text;
}

listview {
    lines: 6;
    columns: 1;
    cycle: true;
    dynamic: true;
    fixed-height: false;
    scrollbar: false;
    spacing: 6px;
}

element {
    padding: 8px 12px;
    border-radius: 8px;
    cursor: pointer;
}

element normal.normal {
    background-color: transparent;
    text-color: @fg-main;
}

element alternate.normal {
    background-color: transparent;
    text-color: @fg-main;
}

element selected.normal {
    background-color: @bg-selected;
    text-color: @fg-bright;
    border: 1px;
    border-color: @border-gold;
    border-radius: 8px;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
    cursor: inherit;
}
