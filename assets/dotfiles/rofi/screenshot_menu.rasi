/**
 * =============================================================================
 * RENAISSANCE OS : ROFI SCREENSHOT MENU THEME
 * Filosofi: Digital Humanism & The Renaissance of Open Source
 * Desain: Modal Tengah Klasik, Kedalaman Tonal & Ambient Shadow
 * Aturan: Tanpa outline oranye (hanya pada Waybar), hairline kaca ultra-subtle
 * =============================================================================
 */

configuration {
    show-icons: false;
    font: "JetBrainsMono Nerd Font 12";
}

* {
    bg-base: rgba(22, 26, 30, 0.96);
    bg-input: rgba(14, 17, 20, 0.85);
    bg-selected: rgba(219, 156, 94, 0.14);
    border-subtle: rgba(255, 255, 255, 0.05);
    border-hairline: rgba(255, 255, 255, 0.04);
    accent-gold: #db9c5e;
    fg-main: #d3c6aa;
    fg-bright: #fbf2db;
    fg-muted: #859289;

    background-color: transparent;
    text-color: @fg-main;
    margin: 0px;
    padding: 0px;
    spacing: 0px;
}

window {
    width: 460px;
    background-color: @bg-base;
    border: 1px;
    border-color: @border-subtle;
    border-radius: 14px;
    padding: 20px;
    location: center;
    anchor: center;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 14px;
}

inputbar {
    background-color: @bg-input;
    border: 1px;
    border-color: @border-hairline;
    border-radius: 8px;
    padding: 8px 14px;
    children: [ prompt, entry ];
    spacing: 10px;
}

prompt {
    text-color: @accent-gold;
    font: "JetBrainsMono Nerd Font Bold 12";
}

entry {
    placeholder: "Pilih aksi tangkapan layar...";
    placeholder-color: @fg-muted;
    text-color: @fg-bright;
    font: "JetBrainsMono Nerd Font 12";
    cursor: text;
}

listview {
    lines: 6;
    columns: 1;
    cycle: true;
    dynamic: true;
    fixed-height: false;
    scrollbar: false;
    spacing: 6px;
}

element {
    padding: 8px 12px;
    border-radius: 8px;
    border: 0px;
    cursor: pointer;
}

element normal.normal {
    background-color: transparent;
    text-color: @fg-main;
}

element alternate.normal {
    background-color: transparent;
    text-color: @fg-main;
}

element selected.normal {
    background-color: @bg-selected;
    text-color: @fg-bright;
    border: 0px;
    border-radius: 8px;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
    cursor: inherit;
}
