/* Rofi Dynamic Monochromatic Matugen Palette */
* {
    bg-base: rgba(17, 20, 22, 0.96);
    bg-input: rgba(25, 28, 31, 0.85);
    bg-selected: rgba(154, 204, 249, 0.18);
    border-subtle: rgba(154, 204, 249, 0.18);
    border-hairline: rgba(154, 204, 249, 0.08);
    accent-gold: #9accf9;
    accent-gold-bright: #9accf9;
    fg-main: #e2e2e6;
    fg-bright: #ffffff;
    fg-muted: #8b9199;
}
