#!/usr/bin/env bash
# ==============================================================================
# RINAUBY : PHILOSOPHICAL MOTTO & QUOTE ROTATOR
# ==============================================================================

CANDIDATES=(
    "$HOME/.config/scripts/quote_rotator.sh"
    "/usr/share/rinauby/scripts/quote_rotator.sh"
)
REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." 2>/dev/null && pwd)"
CANDIDATES+=("$REPO_DIR/dotfiles/scripts/quote_rotator.sh")
CANDIDATES+=("/home/rifqi/Workspace/Belajar/SO/Tubes-2604/Rancangan/assets/dotfiles/scripts/quote_rotator.sh")

for s in "${CANDIDATES[@]}"; do
    if [ -f "$s" ]; then
        exec bash "$s" "$@"
    fi
done

if [ "$1" == "--next" ] || [ "$1" == "--random" ]; then
    quickshell -c rs ipc call rinaubybar rotateQuote >/dev/null 2>&1 || \
    quickshell -c rs ipc call waybar rotateQuote >/dev/null 2>&1 || true
fi

if [ -f "/tmp/current_renaissance_quote" ]; then
    cat "/tmp/current_renaissance_quote"
else
    echo "La Rinascita"
fi
