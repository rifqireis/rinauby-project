#!/usr/bin/env bash
# ==============================================================================
# RINAUBY : RIGHT-SIDE CONTROL CENTER & SYSTEM PANEL
# Quickshell Masterpiece Component (Replaces SwayNC)
# ==============================================================================

QS_CFG="$(cd "$(dirname "${BASH_SOURCE[0]}")/../dotfiles/quickshell" 2>/dev/null && pwd)/shell.qml"
[ -f "$QS_CFG" ] || QS_CFG="$HOME/.config/quickshell/shell.qml"

if ! pgrep -x quickshell >/dev/null && ! pgrep -x qs >/dev/null; then
    quickshell -p "$QS_CFG" >/dev/null 2>&1 &
    sleep 0.4
fi

if ! quickshell -c rs ipc call main handleCommand "system" "" "" >/dev/null 2>&1; then
    quickshell -p "$QS_CFG" ipc call main handleCommand "system" "" "" >/dev/null 2>&1 || \
    quickshell -p "$HOME/.config/quickshell/shell.qml" ipc call main handleCommand "system" "" "" >/dev/null 2>&1 || \
    quickshell ipc call main handleCommand "system" "" "" >/dev/null 2>&1
fi

