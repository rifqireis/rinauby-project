#!/usr/bin/env bash
# ==============================================================================
# RINAUBY : 3D SKEWED COVERFLOW WALLPAPER SELECTOR
# Quickshell Masterpiece Component
# ==============================================================================

QS_CFG="$(cd "$(dirname "${BASH_SOURCE[0]}")/../dotfiles/quickshell" 2>/dev/null && pwd)/shell.qml"
[ -f "$QS_CFG" ] || QS_CFG="$HOME/.config/quickshell/shell.qml"

if ! pgrep -x quickshell >/dev/null && ! pgrep -x qs >/dev/null; then
    quickshell -p "$QS_CFG" >/dev/null 2>&1 &
    sleep 0.4
fi

quickshell -p "$HOME/.config/quickshell/shell.qml" ipc call main handleCommand "wallpaper" "" "" 2>/dev/null || \
quickshell -p "$QS_CFG" ipc call main handleCommand "wallpaper" "" "" 2>/dev/null || \
quickshell ipc call main handleCommand "wallpaper" "" "" 2>/dev/null
