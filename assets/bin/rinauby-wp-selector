#!/usr/bin/env bash
# ==============================================================================
# RINAUBY : 3D SKEWED COVERFLOW WALLPAPER SELECTOR
# Quickshell Masterpiece Component
# ==============================================================================

QS_CFG="$(cd "$(dirname "${BASH_SOURCE[0]}")/../dotfiles/quickshell" 2>/dev/null && pwd)/shell.qml"
[ -f "$QS_CFG" ] || QS_CFG="$HOME/.config/quickshell/shell.qml"

if ! pgrep -x quickshell >/dev/null && ! pgrep -x qs >/dev/null; then
    if [ -d "$HOME/.config/quickshell/rs" ] || [ -f "$HOME/.config/quickshell/shell.qml" ]; then
        quickshell -c rs -d >/dev/null 2>&1 &
    else
        quickshell -p "$QS_CFG" >/dev/null 2>&1 &
    fi
    sleep 0.4
fi

if ! quickshell -c rs ipc call main handleCommand "wallpaper" "" "" >/dev/null 2>&1; then
    quickshell -p "$QS_CFG" ipc call main handleCommand "wallpaper" "" "" >/dev/null 2>&1 || \
    quickshell -p "$HOME/.config/quickshell/shell.qml" ipc call main handleCommand "wallpaper" "" "" >/dev/null 2>&1 || \
    quickshell ipc call main handleCommand "wallpaper" "" "" >/dev/null 2>&1
fi
