#!/usr/bin/env bash
CANDIDATES=(
    "$HOME/.config/rofi/wp_selector.sh"
    "/usr/share/rinauby/rofi/wp_selector.sh"
)
REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." 2>/dev/null && pwd)"
CANDIDATES+=("$REPO_DIR/dotfiles/rofi/wp_selector.sh")
CANDIDATES+=("/home/rifqi/Workspace/Belajar/SO/Tubes-2604/Rancangan/assets/dotfiles/rofi/wp_selector.sh")

for s in "${CANDIDATES[@]}"; do
    if [ -f "$s" ]; then
        exec bash "$s" "$@"
    fi
done
