#!/usr/bin/env bash
# ==============================================================================
# RINAUBY : WINDOW TITLE FETCHER (LEGACY COMPATIBILITY)
# Handled natively in Quickshell RinaubyBar.
# ==============================================================================
if command -v hyprctl >/dev/null 2>&1; then
    hyprctl activewindow -j 2>/dev/null | jq -r '.title // empty' 2>/dev/null || cat /tmp/current_wallpaper_title 2>/dev/null || echo "Desktop"
else
    cat /tmp/current_wallpaper_title 2>/dev/null || echo "Desktop"
fi
