#!/usr/bin/env bash
# ==============================================================================
# RINAUBY : SESSION CONTROLS / POWER MENU
# Native Quickshell Component (Replaces Rofi powermenu.rasi)
# ==============================================================================

QS_CFG="$(cd "$(dirname "${BASH_SOURCE[0]}")/../dotfiles/quickshell" 2>/dev/null && pwd)/shell.qml"
[ -f "$QS_CFG" ] || QS_CFG="$HOME/.config/quickshell/shell.qml"

if ! pgrep -x quickshell >/dev/null && ! pgrep -x qs >/dev/null; then
    quickshell -p "$QS_CFG" >/dev/null 2>&1 &
    sleep 0.4
fi

quickshell -p "$QS_CFG" ipc call launcher toggle "powermenu" >/dev/null 2>&1 || \
quickshell -p "$HOME/.config/quickshell/shell.qml" ipc call launcher toggle "powermenu" >/dev/null 2>&1 || \
quickshell ipc call launcher toggle "powermenu" >/dev/null 2>&1
